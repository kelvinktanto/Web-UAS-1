generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Buku {
  id          Int      @id @default(autoincrement())
  judul       String
  penulis     String
  kategori    String
  tahun       Int?
  stok        Int      @default(0)
  jumlahStok  Int      @default(0)
  deskripsi   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pendaftar {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  telepon   String?
  pesan     String?
  createdAt DateTime @default(now())
}
